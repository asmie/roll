#ifndef GENERATED_RH_CONFIG_H_IN
#define GENERATED_RH_CONFIG_H_IN

// ---- Versioning -----------------------------------------------------------

#define RH_VERSION_MAJOR @RH_VERSION_MAJOR@
#define RH_VERSION_MINOR @RH_VERSION_MINOR@
#define RH_VERSION_REV   @RH_VERSION_REV@

// ---- Header availability (CMake check_include_file_cxx) -------------------

#cmakedefine RH_HAVE_ALGORITHM
#cmakedefine RH_HAVE_ATOMIC
#cmakedefine RH_HAVE_BIT
#cmakedefine RH_HAVE_CCTYPE
#cmakedefine RH_HAVE_CLIMITS
#cmakedefine RH_HAVE_CONCEPTS
#cmakedefine RH_HAVE_CSTDDEF
#cmakedefine RH_HAVE_CSTDINT
#cmakedefine RH_HAVE_CSTDIO
#cmakedefine RH_HAVE_CSTDLIB
#cmakedefine RH_HAVE_CSTRING
#cmakedefine RH_HAVE_EXPECTED
#cmakedefine RH_HAVE_FILESYSTEM
#cmakedefine RH_HAVE_FSTREAM
#cmakedefine RH_HAVE_FUNCTIONAL
#cmakedefine RH_HAVE_FUTURE
#cmakedefine RH_HAVE_IOMANIP
#cmakedefine RH_HAVE_IOSTREAM
#cmakedefine RH_HAVE_LIMITS
#cmakedefine RH_HAVE_SPAN
#cmakedefine RH_HAVE_SSTREAM
#cmakedefine RH_HAVE_STDEXCEPT
#cmakedefine RH_HAVE_STRING
#cmakedefine RH_HAVE_STRING_VIEW
#cmakedefine RH_HAVE_SYSTEM_ERROR
#cmakedefine RH_HAVE_TYPE_TRAITS
#cmakedefine RH_HAVE_UNORDERED_MAP
#cmakedefine RH_HAVE_UTILITY
#cmakedefine RH_HAVE_VECTOR

// ---- Symbol availability (CMake check_cxx_source_compiles) ----------------
//
// The project requires C++23 in CMakeLists.txt, so these symbols *should*
// always be present — but some toolchains advertise C++23 with an older
// libstdc++/libc++ where these are still missing. Probe them at configure
// time and fail loudly rather than producing cryptic template errors.

#cmakedefine RH_HAVE_STD_BYTESWAP        // <bit>, C++23
#cmakedefine RH_HAVE_STD_ENDIAN          // <bit>, C++20
#cmakedefine RH_HAVE_STD_SPAN            // <span>, C++20
#cmakedefine RH_HAVE_STD_FILESYSTEM      // <filesystem>, C++17
#cmakedefine RH_HAVE_STD_TO_UNDERLYING   // <utility>, C++23
#cmakedefine RH_HAVE_STD_EXPECTED        // <expected>, C++23
#cmakedefine RH_HAVE_STD_CONCEPTS_DERIVED_FROM  // <concepts>, C++20

// ---- Critical-header gate -------------------------------------------------
//
// These headers are load-bearing for the project: removing any of them
// requires a non-trivial refactor. Catch missing-toolchain situations at
// preprocess time rather than at deep template-instantiation time.

#if !defined(RH_HAVE_BIT) || !defined(RH_HAVE_CONCEPTS) || \
    !defined(RH_HAVE_EXPECTED) || \
    !defined(RH_HAVE_FILESYSTEM) || !defined(RH_HAVE_SPAN) || \
    !defined(RH_HAVE_STRING_VIEW) || !defined(RH_HAVE_SYSTEM_ERROR) || \
    !defined(RH_HAVE_CSTDINT) || !defined(RH_HAVE_VECTOR) || \
    !defined(RH_HAVE_UNORDERED_MAP)
#error "rolling_hash needs a C++23-capable standard library (missing required header)."
#endif

// ---- Critical-symbol gate -------------------------------------------------

#if !defined(RH_HAVE_STD_BYTESWAP) || !defined(RH_HAVE_STD_ENDIAN) || \
    !defined(RH_HAVE_STD_SPAN) || !defined(RH_HAVE_STD_FILESYSTEM) || \
    !defined(RH_HAVE_STD_TO_UNDERLYING) || !defined(RH_HAVE_STD_EXPECTED) || \
    !defined(RH_HAVE_STD_CONCEPTS_DERIVED_FROM)
#error "rolling_hash needs std::byteswap, std::endian, std::span, std::filesystem, std::to_underlying, std::expected, and std::derived_from."
#endif

// A specific and easily-mistaken combination: Clang before 19 reports
// __cpp_concepts as 201907 rather than 202002 (it lacked P0848R3), and
// libstdc++ gates <expected> on __cpp_concepts >= 202002L. So Clang 18 with
// libstdc++ compiles as C++23 yet has no std::expected, and the failure above
// looks like a missing standard library rather than a compiler mismatch.
// Either use GCC 13+, Clang 19+, or Clang with -stdlib=libc++.
#if !defined(RH_HAVE_STD_EXPECTED) && defined(__clang__) && (__clang_major__ < 19)
#error "Clang < 19 with libstdc++ has no std::expected (it under-reports __cpp_concepts). Use GCC 13+, Clang 19+, or add -stdlib=libc++."
#endif

#endif /* GENERATED_RH_CONFIG_H_IN */
